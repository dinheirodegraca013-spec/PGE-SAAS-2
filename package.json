{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "audit:sql-security": "node scripts/audit-sql-security.mjs",
    "verify:integrity": "node scripts/verify-repository-integrity.mjs",
    "verify:release": "npm run test && npm run lint && npm run audit:dependencies && npm run audit:sql-security && npm run verify:integrity && npm run build && npm run audit:production",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axios": "^1.21.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "follow-redirects": "^1.16.2"
  }
}
